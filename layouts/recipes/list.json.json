{{- /*
  /recipes/index.json: a machine-readable index of every recipe, for
  tools and agents that answer questions about the collection (coverage,
  missing metadata, which recipes have a Mechanic or a formula) without
  parsing the content folder. Built only when the recipes section's
  _index.md asks for it with `outputs: [HTML, RSS, JSON]`.

  One entry per recipe, by title: frontmatter facts, word count, and
  has_* flags for the optional sections. The flags are substring checks on
  the raw Markdown, so a "## Notes" inside a code block counts too.
  `generated` is the build date, so this file differs between builds made
  on different days.
*/ -}}
{{- $recipes := slice -}}
{{- range .RegularPages.ByTitle -}}
  {{- $raw := .RawContent -}}
  {{- $recipe := dict
    "title"          .Title
    "slug"           .File.ContentBaseName
    "date"           (cond (not .Date.IsZero) (.Date.Format "2006-01-02") "")
    "tags"           .Params.tags
    "cuisine"        .Params.cuisine
    "servings"       .Params.servings
    "portions"       .Params.portions
    "source"         .Params.source
    "prep_time"      .Params.prep_time
    "cook_time"      .Params.cook_time
    "draft"          .Draft
    "working_on"     .Params.working_on
    "word_count"     .WordCount
    "has_mechanic"   (strings.Contains $raw "## Mechanic")
    "has_variations" (strings.Contains $raw "## Variations")
    "has_notes"      (strings.Contains $raw "## Notes")
    "has_formula"    (strings.Contains $raw "```formula")
  -}}
  {{- $recipes = $recipes | append $recipe -}}
{{- end -}}
{{- dict
    "generated" (now.Format "2006-01-02")
    "count"     (len $recipes)
    "recipes"   $recipes
  | jsonify (dict "indent" "  ") -}}
